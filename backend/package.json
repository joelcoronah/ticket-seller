{
  "name": "flashsale-backend",
  "version": "0.1.0",
  "private": true,
  "description": "High-concurrency ticketing / flash-sale engine (NestJS + Redis + Kafka + PostgreSQL)",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev:api": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "test:race": "node scripts/race-test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-fastify": "^11.2.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "~5.6"
  }
}
